# ── Akses MAGMA dan aplikasi ─────────────────────────────
APP_ID=
SECRET_KEY=
MS_KEY=replace-with-a-long-random-token
BASE_URL="https://vsi.esdm.go.id/data"
AUTH_API_BASE_URL=""

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://esdm_user:password@db:5432/esdm_db
SYNC_DATABASE_URL=postgresql+psycopg2://esdm_user:password@db:5432/esdm_db
DB_USER=esdm_user
DB_PASSWORD=password
DB_NAME=esdm_db

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── Auth & Domain ────────────────────────────────────────
DOMAIN_EMAIL=@esdm.id,google.com

# ── LLM APIs ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_BASE=http://openai-local:8002/v1
OPENAI_MODEL="qwen2.5-1.5b-instruct"

LOCAL_LLM_MAX_TOKENS=180
LOCAL_MODEL_TIMEOUT_SECONDS=30

OPENROUTER_API_KEY=
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="MAGMA AI"
OPENROUTER_TIMEOUT_SECONDS=30

GEMINI_API_KEY=
MISTRAL_API_KEY=

GROQ_API_KEY=
GROQ_TIMEOUT_SECONDS=30

# ── WhatsApp / Evolution API ─────────────────────────────
EVOLUTION_INTERNAL_URL=http://evolution-api:8080
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_INSTANCE=esdm-assistant
EVOLUTION_INSTANCE_NAME=esdm-assistant

# ── Pemrosesan dokumen ───────────────────────────────────
DOCUMENT_OCR_ENABLED=false
DOCUMENT_QUEUE_POLL_SECONDS=2
EMBEDDING_BATCH_SIZE=32
LOG_LEVEL=INFO

# ── Licensing ────────────────────────────────────────────
LICENSE_PATH=
DISABLE_LICENSE=false

# ── SSH Tunnel (optional) ────────────────────────────────
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=

# ── Dev / Misc ───────────────────────────────────────────
POSTMAN_API_KEY=
KB_TOKEN=
