# ── Model Configuration ───────────────────────────────────
MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
MODEL_NAME=qwen2.5-1.5b-instruct

# ── Model Parameters ──────────────────────────────────────
N_CTX=4096
N_THREADS=4
N_BATCH=512
N_GPU_LAYERS=0
SEED=-1
F16_KV=true
VERBOSE=false

# ── GPU ───────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0

# ── Features ──────────────────────────────────────────────
EMBEDDING_ENABLED=true
BATCH_ENABLED=false
BATCH_SIZE=4
BATCH_TIMEOUT_MS=100

# ── Auth ──────────────────────────────────────────────────
# Jika diisi, samakan dengan OPENAI_API_KEY pada ms-esdm/.env.
API_KEY=

# Variabel lama yang mungkin ada di .env; main.py saat ini tetap melayani
# 0.0.0.0:8002 dan tidak membaca ketiganya untuk konfigurasi server.
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=info
