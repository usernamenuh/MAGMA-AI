[Unit]
Description=MAGMA-AI LLM Server
After=network-online.target
Wants=network-online.target

[Container]
Image=172.16.2.228:5000/magma-ai-llm:latest
EnvironmentFile=/opt/secrets/openai-local/.env
Network=host
Entrypoint=python3
Exec=main.py

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
